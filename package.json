{
  "name": "factory-puzzle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app",
    "web": "npm run web --workspace app",
    "build:web": "npm run build:web --workspace app",
    "generate": "node --experimental-strip-types packages/gen/src/cli.ts"
  },
  "devDependencies": {
    "eas-cli": "^21.8.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
